# Google AI Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=0

# Agent Configuration
AGENT_MODEL=gemini-3.1-flash-lite

# OpenAlgo Configuration
OPENALGO_API_KEY=your_openalgo_api_key_here
OPENALGO_HOST=https://trade.uacinfo.com

# Path to the OpenAlgo MCP Bridge (relative or absolute)
MCP_SERVER_PATH=/path/to/openalgo/mcp/mcpserver.py

# Optional: Port for ADK Web UI
# PORT=8000
